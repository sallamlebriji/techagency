# Local : laisser vide pour utiliser SQLite.
MONGODB_URI=
MONGODB_DB=techagency
# Chemins absolus recommandés en production ; vide = backend/data et backend/uploads.
SQLITE_PATH=
MEDIA_DIR=
PORT=4000
HOST=127.0.0.1
PUBLIC_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173
# Production : NODE_ENV=production, URLs HTTPS et secret aléatoire >=32 caractères.
# Ne pas mettre de secret réel dans ce fichier exemple.
SESSION_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=
TRUST_PROXY=0
